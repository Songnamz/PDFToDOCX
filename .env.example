# Best Thai text: Typhoon OCR (free key at https://opentyphoon.ai)
TYPHOON_OCR_API_KEY=
# ...or your own GPU server running:  vllm serve scb10x/typhoon-ocr1.5-2b --served-model-name typhoon-ocr
# TYPHOON_BASE_URL=http://gpu-box:8000/v1
# TYPHOON_MODEL=typhoon-ocr

# Protect the site (HTTP Basic auth, any username)
APP_PASSWORD=change-me

JOB_TTL_MINUTES=30
MAX_UPLOAD_MB=30
MAX_PAGES=40
WORKERS=2
